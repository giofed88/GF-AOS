{
  "description": "GF-AOS lifecycle privacy-first: checkpoint canonico, contesto minimo e nessuna acquisizione del transcript.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/session_start.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\session_start.py\"",
            "timeout": 15,
            "additionalContextLimit": 3000,
            "statusMessage": "Ripresa checkpoint GF-AOS"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/runtime_hooks.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\runtime_hooks.py\"",
            "timeout": 10,
            "statusMessage": "Verifica checkpoint GF-AOS"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/runtime_hooks.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\runtime_hooks.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/runtime_hooks.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\runtime_hooks.py\"",
            "timeout": 10,
            "additionalContextLimit": 600,
            "statusMessage": "Applica contesto minimo GF-AOS"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/runtime_hooks.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\runtime_hooks.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/runtime_hooks.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\runtime_hooks.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
